# Copia como .env solo para desarrollo local (npm run dev). Nunca subas .env a GitHub.
# En Cloud Run estas variables se configuran en el despliegue y las claves vienen de Secret Manager.

NODE_ENV=development
PORT=8080

# Clave de Gemini de un proyecto CON facturación activa (así Google no usa los datos para entrenar)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Tiempo máximo por pregunta, reintento incluido (ms)
GEMINI_BUDGET_MS=8000

OPENWEATHER_API_KEY=

# Solo en local: off desactiva App Check y memory guarda las cuotas en memoria.
# En producción el servidor se niega a arrancar con estos valores.
APP_CHECK_MODE=off
QUOTA_BACKEND=memory

COACH_DAILY_LIMIT=20
COACH_GLOBAL_DAILY_LIMIT=2000
QUOTA_TIME_ZONE=America/Bogota
LOG_LEVEL=debug
