{
  "name": "hidrasmart-api",
  "version": "1.0.0",
  "private": true,
  "description": "Servidor intermediario de HidraSmart: coach de IA (Gemini) y clima, sin claves en la app.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "firebase-admin": "^14.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
