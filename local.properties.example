# Copia este archivo como local.properties (Android Studio ya crea uno con sdk.dir)
# y agrega tus claves. Ese archivo NO se sube a GitHub.

# Clima: clave gratuita de https://openweathermap.org/api (Current Weather Data).
# Sin clave, la app usa la temperatura y humedad manuales del perfil.
OPENWEATHER_API_KEY=pega_aqui_tu_clave

# Coach de IA: clave gratuita de Google AI Studio (https://aistudio.google.com/apikey).
# Sin clave, el coach responde con la IA local (sin internet).
GEMINI_API_KEY=pega_aqui_tu_clave
# Opcional: modelo de Gemini (por defecto gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite
